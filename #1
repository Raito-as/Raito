SaveLocationBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char then
        TelepotInfoLabel.Text = "Không tìm thấy nhân vật"
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        TelepotInfoLabel.Text = "Không tìm thấy HumanoidRootPart"
        return
    end

    local cf = hrp.CFrame
    local locationData = {
        X = cf.Position.X,
        Y = cf.Position.Y,
        Z = cf.Position.Z,
        R00 = cf.RightVector.X,
        R01 = cf.UpVector.X,
        R02 = cf.LookVector.X,
        R10 = cf.RightVector.Y,
        R11 = cf.UpVector.Y,
        R12 = cf.LookVector.Y,
        R20 = cf.RightVector.Z,
        R21 = cf.UpVector.Z,
        R22 = cf.LookVector.Z
    }

    table.insert(_G.SavedTelepotLocations, locationData)
    local newIndex = #_G.SavedTelepotLocations
    selectedTelepotLocation = newIndex

    SelectedLocationLabel.Text = "Đã Lưu Địa Điểm " .. newIndex
    SelectedLocationLabel.TextColor3 = THEME.Active
    SelectLocationBtn.Text = "Địa Điểm " .. newIndex

    TelepotInfoLabel.Text = "Đã Lưu Địa Điểm " .. newIndex
    SaveSettings()
    RefreshTelepotMenu()

    task.delay(1.5, function()
        if TelepotInfoLabel then
            TelepotInfoLabel.Text = "Có thể lưu nhiều địa điểm"
        end
    end)
end)


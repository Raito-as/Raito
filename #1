    local data = _G.SavedTelepotLocations[selectedTelepotLocation]
    if not data then
        selectedTelepotLocation = nil
        SelectedLocationLabel.Text = "[ Chưa chọn địa điểm ]"
        SelectLocationBtn.Text = "Chọn Địa Điểm"
        return
    end

    local char = LocalPlayer.Character
    if not char then
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return
    end

    local position = Vector3.new(data.X, data.Y, data.Z)
    local right = Vector3.new(data.R00, data.R10, data.R20)
    local up = Vector3.new(data.R01, data.R11, data.R21)
    local look = Vector3.new(data.R02, data.R12, data.R22)

    hrp.CFrame = CFrame.fromMatrix(position, right, up, -look)

    TelepotInfoLabel.Text = "Đã Dịch Chuyển → Địa Điểm " .. selectedTelepotLocation
    task.delay(1.5, function()
        if TelepotInfoLabel then
            TelepotInfoLabel.Text = "Có thể lưu nhiều địa điểm"
        end
    end)
end)

